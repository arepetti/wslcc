<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin this repository to the public NuGet feed for reproducible restores, independent of any
    machine-level sources. All WSLCC dependencies are published on nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
